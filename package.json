{
  "name": "wind-calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name wind-calendar vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint && pnpm run lint:effect",
    "lint:fix": "oxlint --fix && pnpm run lint:effect --fix",
    "lint:ci": "oxlint --format=github && pnpm run lint:effect --format=github",
    "lint:effect": "oxlint --config .oxlintrc.effect.json --disable-nested-config server tests",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:rtl": "node --test tests/browser/switch-direction.test.mjs",
    "test:production-logs": "pnpm build && node --test tests/production/observability.test.mjs",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run fmt:check && pnpm run lint && tsc -b && vitest run",
    "preview": "vite preview",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.99",
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/flags-core": "^1.10.1",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.0.5",
    "i18next": "^26.3.6",
    "ics": "^3.12.1",
    "lucide-react": "^1.61.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.0.11",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/tsgo": "0.55.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/config": "^0.13.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "portless": "^0.15.8",
    "typescript": "~7.0.2",
    "vercel": "^65.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@11.21.0"
}
