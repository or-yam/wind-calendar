{
  "name": "wind-calendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run --name wind-calendar vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ci": "oxlint --format=github",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run fmt:check && pnpm run lint && tsc -b && vitest run",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/flags-core": "^1.9.0",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "^4.0.5",
    "ics": "^3.12.1",
    "lucide-react": "^1.52.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/config": "^0.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.86.0",
    "portless": "^0.15.7",
    "typescript": "~7.0.2",
    "vercel": "^58.11.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@11.21.0"
}
