# Server-only OpenAI credential. Never prefix this with VITE_ or commit a real value.
OPENAI_API_KEY=your_openai_api_key

# Run `vercel link && vercel env pull` to load Vercel Flags credentials locally.

# Public PostHog ingestion settings. Analytics remains disabled when the token is absent.
VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
