# Server-only OpenAI credential. Never prefix this with VITE_ or commit a real value.
OPENAI_API_KEY=your_openai_api_key

# Optional server-only Langfuse observability credentials. Set both or tracing is disabled.
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional dedicated HMAC secret for feedback tokens; preferred to decouple key rotation.
LANGFUSE_FEEDBACK_SECRET=generate_a_random_32_byte_secret

# Run `vercel link && vercel env pull` to load Vercel Flags credentials locally.
