# Server-only OpenAI credential. Never prefix this with VITE_ or commit a real value.
OPENAI_API_KEY=your_openai_api_key

# Run `vercel link && vercel env pull` to load Vercel Flags credentials locally.

# Sentry runtime DSNs. VITE_SENTRY_DSN is public by design; SENTRY_DSN stays server-only.
VITE_SENTRY_DSN=
SENTRY_DSN=

# Build-only source map upload credentials. Never expose the auth token through VITE_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional Sentry event labels. These do not control whether reporting is enabled.
# Reporting is limited to Vercel Preview and Production deployments via VERCEL_ENV.
# Vercel environment and commit SHA are used when these are absent.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
